# Backend API URL (use direct localhost:5000 in dev or leave blank for Vite proxy)
VITE_API_BASE_URL=http://localhost:5000
VITE_ADMIN_TOKEN_KEY

# Firebase Web App Config (Required for Google Sign-In on /admin)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=leetverse-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leetverse-website
VITE_FIREBASE_STORAGE_BUCKET=leetverse-website.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
